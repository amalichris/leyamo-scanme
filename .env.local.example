# Leyamo ScanMe - Environment Variables
# Copy this file to .env.local and fill in your actual URLs
# NOTE: .env.local should NOT be committed to version control

# iOS App Store URL
VITE_APP_STORE_URL=https://apps.apple.com/app/id6751813039

# Android Google Play Store URL
VITE_GOOGLE_PLAY_URL=https://joinleyamo.com/

# Fallback URL for desktop and other devices
VITE_FALLBACK_URL=https://joinleyamo.com
